APP_NAME=API Gateway
APP_PORT=8000

AUTH_SERVICE_URL=http://users-service:8001
SALE_SERVICE_URL=http://sale-service:8003
INVENTORY_SERVICE_URL=http://inventory-service:8002
REPORT_SERVICE_URL=http://report-service:8004

# Chỉ tin header IP client (CF-Connecting-IP / X-Forwarded-For) khi request
# đến từ proxy nằm trong danh sách này (IP hoặc CIDR). Nginx trên host,
# cloudflared (Cloudflare Tunnel) hay proxy container đều đi vào gateway qua
# mạng bridge của Docker nên dải 172.16.0.0/12 là đủ. Để trống (mặc định) =
# không bao giờ tin header, tránh bị giả mạo IP để bypass rate limit.
TRUSTED_PROXY_IPS=["172.16.0.0/12"]

# Rate limit (request/phút) cho các endpoint public/* không yêu cầu xác thực,
# ví dụ tra cứu hóa đơn theo số điện thoại — cần chặt hơn để tránh dò quét.
PUBLIC_RATE_LIMIT_RPM=30
